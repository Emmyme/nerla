{
  // The same settings as the server's, since prepare.ts runs the server's own seed and migrations
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "types": ["node", "@fastify/cookie"]
  },
  // tsc checks the types, so ts-node only strips them and prepare starts in seconds
  "ts-node": { "transpileOnly": true },
  // The server's own augmentations of the Fastify types, for the server code the seed reaches
  "include": ["*.ts", "journeys/**/*.ts", "../server/src/types/*.d.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}

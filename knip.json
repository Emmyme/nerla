{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "server": {
      "entry": ["src/scripts/*.ts", "scripts/**/*.ts", "vitest.unit.config.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "drizzle": false
    },
    "website": {
      "entry": ["postcss.config.mjs", "public/theme-init.js"],
      "ignore": ["src/app/nerla-themes.css"],
      "ignoreDependencies": ["tailwindcss-animate", "@tailwindcss/postcss", "tailwindcss"]
    },
    "e2e": {
      "entry": ["playwright.config.ts", "auth.setup.ts", "journeys/**/*.spec.ts"],
      "playwright": false,
      "ignoreDependencies": ["vite", "@fastify/cookie"]
    }
  }
}

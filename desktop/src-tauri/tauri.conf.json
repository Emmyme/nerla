{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nerla-desktop",
  "version": "0.1.0",
  "identifier": "com.nerla.desktop",
  "build": {
    "frontendDist": "../../website/dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "yarn workspace website dev",
    "beforeBuildCommand": "yarn workspace website build"
  },
  "app": {
    "windows": [
      {
        "title": "Nerla",
        "width": 1150,
        "height": 750,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3001 http://127.0.0.1:3001 ws://localhost:3001 ws://127.0.0.1:3001 http://localhost:5000 http://127.0.0.1:5000 ws://localhost:5000 ws://127.0.0.1:5000 ws://localhost:7880 ws://127.0.0.1:7880 https: wss:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:5000 http://127.0.0.1:5000",
        "media-src": "'self' customprotocol: asset: blob:",
        "object-src": "'self' customprotocol: asset: blob:",
        "font-src": "'self' data: http://localhost:5000 http://127.0.0.1:5000 https:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

{
  "name": "server",
  "version": "1.0.0",
  "description": "Nerla backend API server",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "npx tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "mutate": "stryker run",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx ts-node src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx ts-node scripts/seed/index.ts",
    "lint": "yarn run -T eslint . --max-warnings 0",
    "lint:fix": "yarn run -T eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "~3.1024.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.2",
    "livekit-server-sdk": "^2.15.0",
    "nodemailer": "^10.0.6",
    "postgres": "^3.4.7",
    "rrule": "^2.8.1",
    "winston": "^3.11.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.9.0",
    "drizzle-kit": "^0.31.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

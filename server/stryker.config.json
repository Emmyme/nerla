{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.unit.config.ts", "related": true },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/utils/aiGate.ts",
    "src/utils/trash.ts",
    "src/utils/taskAccess.ts",
    "src/utils/docAccess.ts",
    "src/services/tenancy.ts",
    "src/services/projectAccess.ts",
    "src/utils/fileAccess.ts",
    "src/utils/chatAccess.ts",
    "src/utils/recurrence.ts",
    "src/utils/timeRules.ts",
    "src/services/timeReports.ts"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 30000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}

# =============================================================================
# Nerla environment template, EXAMPLE VALUES ONLY, NOT REAL SECRETS.
#
# You normally do NOT edit this by hand. Run the installer instead:
#   ./setup.sh       production, generates strong, unique secrets and writes .env
#   ./setup-dev.sh   local development
#
# Leave the secrets empty. Setup fills each empty one with a strong random value.
# In PRODUCTION the server REFUSES TO START if JWT_SECRET / LIVEKIT_API_SECRET / DB_PASSWORD are
# left at a default or weak value (see server/src/config.ts).
#
# If you must fill this in manually, generate secrets with:  openssl rand -hex 32
# A secret can instead come from a file in the secrets folder, which the containers see as /run/secrets.
# Set NAME_FILE to its path there and leave NAME empty, for example JWT_SECRET_FILE=/run/secrets/jwt_secret.
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET stay here. SETUP.md, under Secrets in files, says more.
# =============================================================================

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=nerla
DB_PASSWORD=
DB_NAME=nerla
# Require TLS for Postgres connections. Set to true when using a remote/managed database.
# The bundled docker-compose Postgres does not support TLS, so use false for local dev.
DB_SSL=false

# Server Configuration
PORT=5000
# Must be development, test, or production. The server refuses to start otherwise,
# because an unset value would silently disable production-only protections.
NODE_ENV=development
CLIENT_URL=http://localhost:3001
SERVER_URL=http://localhost:5000

# Number of reverse proxy hops in front of the server, so per-IP rate limits key
# on the real client address. Use 1 behind the bundled web proxy, 2 with your own proxy in front of it, false when the
# server is exposed directly (otherwise clients can spoof X-Forwarded-For). A count needs the nearest proxy on a private
# network, as the bundled one is. Otherwise set the proxy's address instead of a count.
TRUST_PROXY=false

# The web proxy in production (setup.sh writes these). SITE_ADDRESS is the domain, an IP address or localhost.
# TLS_MODE is acme for Let's Encrypt, or internal for an IP address or localhost. ACME_EMAIL is optional.
# Behind your own proxy, SETUP.md's Running behind your own proxy lists the lines to set instead.
SITE_ADDRESS=
TLS_MODE=acme
ACME_EMAIL=

# Returns password reset tokens in the API response so local testing works
# without SMTP. The server refuses to start with this enabled in production.
EXPOSE_RESET_TOKEN=false

# The code the first sign-up must give to become the admin. setup.sh makes one. Empty means no code is asked for
SETUP_TOKEN=

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=

# Web App Configuration, development only. The web image talks to the address it was served from
VITE_API_URL=http://localhost:5000/api

# File storage, any S3-compatible store. Setup fills these in for the bundled Garage, the keys once Garage is provisioned.
# STORAGE_DRIVER=local keeps files on the server's own disk instead, in STORAGE_PATH (default /data/files)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=nerla-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# A store of your own instead, with its keys in S3_ACCESS_KEY and S3_SECRET_KEY:
#   Cloudflare R2:  S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2:   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com  S3_REGION=us-west-004
#   AWS S3:         S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com  S3_REGION=eu-north-1  S3_FORCE_PATH_STYLE=false
#   Hetzner:        S3_ENDPOINT=https://fsn1.your-objectstorage.com  S3_REGION=fsn1

# The bundled Garage's own secrets (generated by setup.sh)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Email Configuration (SMTP)
# Required for sending invite and password-reset emails.
# Works with any SMTP provider: Gmail, Outlook, AWS SES, self-hosted, etc.
# If left unconfigured, invite/reset links are logged to the server console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Nerla <noreply@yourdomain.com>

# The largest upload in MB. Admins can only lower it. The bundled web proxy allows 200 MB on the upload route
MAX_UPLOAD_MB=200

# LiveKit Configuration (generated by setup.sh)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Development only, the web image carries no address
VITE_LIVEKIT_URL=ws://localhost:7880

# The LiveKit address clients dial, sent with each meeting token. Production needs it (for example wss://example.com:7880)
# Empty keeps the client's VITE_LIVEKIT_URL, which only development sets
LIVEKIT_PUBLIC_URL=

# Seals the AI model keys saved in Settings (64 hex characters, for example from: openssl rand -hex 32).
# Without it the server still starts, but saving a key is refused. Keep it safe, a lost key means keys are entered again.
AI_MASTER_KEY=

# Where ./nerla update pulls the release images from
# NERLA_REGISTRY=ghcr.io/emmyme
# Set to source to build the images here instead of pulling the release's
NERLA_BUILD=

{
  "name": "nerla",
  "version": "1.0.0",
  "description": "Open-source project management and collaboration platform",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "server",
    "desktop",
    "website",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace server dev\" \"yarn workspace website dev\"",
    "dev:server": "yarn workspace server dev",
    "dev:web": "yarn workspace website dev",
    "dev:desktop": "yarn workspace desktop tauri:dev",
    "build": "yarn workspace server build && yarn workspace website build",
    "build:server": "yarn workspace server build",
    "build:web": "yarn workspace website build",
    "icon": "node scripts/build-app-icon.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:desktop": "yarn workspace desktop tauri:build",
    "start": "yarn workspace server start",
    "db:seed": "yarn workspace server db:seed",
    "test": "yarn workspace server test && yarn workspace website test",
    "test:e2e": "yarn workspace e2e test",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || echo \"⚠ git config failed, so the commit hook is not set up here.\"",
    "knip": "knip"
  },
  "keywords": [
    "project-management",
    "communication",
    "collaboration",
    "open-source",
    "self-hosted"
  ],
  "author": "Emelie Berg",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "knip": "^5",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=26.0.0",
    "yarn": ">=4.0.0"
  }
}
